# Service to set stream parameters at runtime.
#
# Request:
#   string subscription_topic
#     The topic name of the stream whose parameters are to be updated.
#   uint8 quality_level
#     Desired quality level for the stream (0 = lowest, 4 = highest).
#     Valid values: 0, 1, 2, 3, 4.
#
# Response:
#   bool success
#     True if the stream parameters were successfully updated, false otherwise.
string subscription_topic
uint8 quality_level
---
bool success
